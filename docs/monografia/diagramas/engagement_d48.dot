digraph EngagementLifecycle {
  graph [rankdir=LR, bgcolor="white", pad="0.32", nodesep="0.5", ranksep="0.9", splines=true, label="Ciclo operacional da contratação (Engagement)", labelloc=t, fontsize=18, fontname="DejaVu Sans", fontcolor="#172235"];
  node [shape=box, style="rounded,filled", fillcolor="#F3F7FA", color="#64748B", fontcolor="#16253A", fontsize=12, fontname="DejaVu Sans", penwidth=1.2, margin="0.19,0.13"];
  edge [color="#475569", fontcolor="#344256", fontsize=10, fontname="DejaVu Sans", arrowsize=0.75, penwidth=1.1];
  start [shape=point, width=0.13, fillcolor="#334155", color="#334155", label=""];
  pending [label="PENDING_AGREEMENT\naguarda acordo"];
  active [label="ACTIVE\nem execução", fillcolor="#E9F4F1", color="#417E76"];
  delivered [label="DELIVERED\nentrega registada", fillcolor="#E9F4F1", color="#417E76"];
  completed [label="COMPLETED\nconcluído", fillcolor="#DCECE6", color="#417E76"];
  cancelled [label="CANCELLED\ncancelado", fillcolor="#FBEDED", color="#B77975"];
  end [shape=doublecircle, width=0.19, fixedsize=true, color="#334155", label="", fillcolor="white"];
  start -> pending;
  pending -> active [label="versão aceite\npelas duas partes"];
  pending -> cancelled [label="cancelamento\npermitido"];
  active -> delivered [label="entrega\nregistada"];
  delivered -> completed [label="conclusão\nvalidada"];
  delivered -> active [label="revisão\nautorizada", constraint=false];
  active -> cancelled [label="cancelamento\npermitido"];
  completed -> end;
  cancelled -> end;
}