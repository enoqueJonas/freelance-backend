# Copy to .env or export these variables in the shell.
# NEVER commit production secrets.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-this-with-a-random-local-development-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional PostgreSQL: DATABASE_URL=postgres://username:password@localhost:5432/conecta
